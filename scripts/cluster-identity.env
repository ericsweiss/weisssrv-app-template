# Cluster identity — the one place this scaffold names a cluster.
#
# The defaults are the weisssrv cluster (git.ericsweiss.com), which is what the
# scaffold targets out of the box. A cluster generated from
# weisssrv-cluster-template edits the values below and runs
# `./scripts/apply-cluster-identity.sh` once, right after `scripts/rename.sh`.
# Leaving every value at its default makes that run a no-op, so an existing
# weisssrv tenant is byte-unchanged.
#
# Only cluster-level facts belong here. The app slug and GitLab group are
# rename.sh's job, and the weisssrv-lib pin is .gitlab-ci.yml's.
# The library's docs/EXTENSIBILITY.md is the family's seam contract.

# Public hostnames: <app>.$CLUSTER_EXTERNAL_DOMAIN, and the external-dns target.
CLUSTER_EXTERNAL_DOMAIN="ericsweiss.com"

# LAN/tailnet hostnames: <app>.$CLUSTER_INTERNAL_DOMAIN (optional/ manifests).
CLUSTER_INTERNAL_DOMAIN="esweiss.com"

# Prefix of the cluster's node labels (esweiss.com/nas, esweiss.com/cpu).
CLUSTER_NODE_LABEL_DOMAIN="esweiss.com"

# The internal ingress VIP an operator points the internal hostname at.
CLUSTER_INTERNAL_VIP="192.168.0.101"

# Container registry the build-image job pushes to, and the INTERNAL name the
# nodes pull from (they differ on weisssrv: the internal one avoids a hairpin).
CLUSTER_REGISTRY_HOST="registry.git.ericsweiss.com"
CLUSTER_REGISTRY_PULL_HOST="registry.git.esweiss.com"

# Runner tag for the ONE privileged job (the image build).
CLUSTER_PRIVILEGED_RUNNER_TAG="infrastructure"
