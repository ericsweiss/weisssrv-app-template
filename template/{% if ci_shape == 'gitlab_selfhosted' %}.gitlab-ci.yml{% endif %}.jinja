---
# CI for {{ app_slug }}: it gates, never deploys. Flux reconciles the tree into
# namespace {{ app_namespace }}. The generic jobs come from `{{ lib_project }}`
# at a pinned tag and are TAG-LESS, so they land on the shared runner.
{%- if enable_image_build %}

# CRITICAL: the image build is the one tagged job (`{{ privileged_runner_tag }}`)
# and sets no `needs:`, so `build` after `security` keeps a privileged build off
# a tree the secret scan has not cleared. Adding `needs:` to it bypasses that.
{%- endif %}
stages:
  - lint
  - security
{%- if enable_image_build %}
  - build
{%- endif %}
  - ai-review
  - release

# Settings every job inherits unless it says otherwise.
default:
  # Cancel a superseded pipeline's jobs on a new commit; see the workflow
{%- if enable_image_build %}
  # policy below. The library's `release` and image-build jobs override this
  # to false themselves.
{%- else %}
  # policy below. The library's `release` job overrides this to false itself.
{%- endif %}
  interruptible: true

workflow:
  # {{ change_request | capitalize }} refs cancel superseded pipelines; main
  # never cancels, because `release` cuts the tag.
  auto_cancel:
    on_new_commit: interruptible
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == "main"'
      auto_cancel:
        on_new_commit: none
    # No `$CI_COMMIT_TAG` clause: no job below runs on a tag pipeline, so the
    # clause could only ever ask GitLab for a pipeline with zero jobs.

variables:
  # Single source for the library pin. `include:` cannot read it (GitLab
  # resolves includes before variables exist), so scripts/check-lib-pins.py
  # keeps the literal `ref:` entries in step.
  WEISSSRV_LIB_REF: "{{ lib_ref }}"

include:
  # -- yaml-lint: lint the whole tree against lint/yamllint-relaxed.yml ------
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/yaml-lint.yml
    inputs:
      tags: []
      config: "-c lint/yamllint-relaxed.yml"
      targets: "."
      changes:
        - "**/*.yaml"
        - "**/*.yml"

  # -- flux-lint: kustomize build + kubeconform (SIMPLE mode) ----------------
  # substitute: false — a tenant pins literal tags, so nothing needs envsubst.
  # kustomize_path is the dir this mode builds.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/validate/flux-lint.yml
    inputs:
      tags: []
      substitute: false
      kustomize_path: "kubernetes/flux"
      # Inert in simple mode; passed so the include reads the same in substitute mode.
      cluster_dir: "kubernetes/flux"
      k8s_version: "{{ k8s_version }}"
      changes:
        - "kubernetes/**/*"
        # The k8s_version input and the library ref live in this file, so a
        # change to how the gate runs re-runs the gate.
        - ".gitlab-ci.yml"

  # -- python-lint: ruff over the helpers in scripts/ ------------------------
  # No `config:` input — ruff discovers the vendored ./ruff.toml. `changes:`
  # must name the same surface as `targets:`, or the job skips a source commit.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/python-lint.yml
    inputs:
      tags: []
      targets: "scripts"
      changes:
        - "scripts/**/*.py"
        - "ruff.toml"
        - ".gitlab-ci.yml"

  # -- comment-length: the comment convention, over the whole tree -----------
  # No `config:`, so the gate is stdlib-only and the PyYAML install is skipped.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/comment-length.yml
    inputs:
      tags: []
      pyyaml_version: ""
      # Every file: the convention applies to every file, and a narrowed list
      # lets an over-long comment land in a path it does not name.
      changes:
        - "**/*"

  # -- lint-docs-links: relative Markdown cross-links resolve -----------------
  # python:3.13 overrides the library's python:3.11; drop the input to take the
  # library's interpreter.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/docs-link-check.yml
    inputs:
      tags: []
      job_name: lint-docs-links
      image: python:3.13
      changes:
        - "**/*.md"
        - "scripts/check-doc-links.py"
        - ".gitlab-ci.yml"

  # -- secret-detection: GitLab Secret Detection (gitleaks) ------------------
  # Findings FAIL the job at the pinned ref, so this blocks the merge. Tuned by
  # .gitleaks.toml via .gitlab/secret-detection-ruleset.toml.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/security/secret-detection.yml
    inputs:
      tags: []
      # The label domain is site data, so the input is always passed explicitly.
      cpu_selector: "{{ ci_cpu_selector }}"
{%- if enable_image_build %}

  # -- build-image: build THIS service's container image ---------------------
  # Pushes $CI_REGISTRY_IMAGE:<short-sha> (+ :latest on main); point
  # deployment.yaml's `image:` at that tag. The one PRIVILEGED job.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/build/docker-build.yml
    inputs:
      tags: ["{{ privileged_runner_tag }}"]
      dockerfile: "Dockerfile"
      # The label domain is site data, so the input is always passed explicitly.
      cpu_selector: "{{ ci_cpu_selector }}"
{%- endif %}

  # -- semantic-release: tag + Release from the conventional commits ----------
  # Merging to main cuts the tag and the Release from the conventional commits
  # since the last one; nothing releasable means no tag and a green pipeline.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/release/semantic-release.yml
    inputs:
      tags: []

  # -- pr-agent AI review: optional, never blocks, BYO keys -------------------
  # CREATED only when both masked CI/CD variables are set. Do not override
  # openai_key/gitlab_token: a renamed variable means no job and no review.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/review/pr-agent.yml
    inputs:
      tags: []
      gitlab_url: "https://{{ git_host }}"
      gate: "$OPENAI__KEY && $GITLAB__PERSONAL_ACCESS_TOKEN"
      # Lint + secret detection only: the review must not wait on anything else.
      # secret_detection is NOT optional, because it is created on every MR
      # pipeline and an all-optional list GitLab empties starts ignoring stages.
      needs:
        - job: yaml-lint
          optional: true
        - job: flux-lint
          optional: true
        - job: secret_detection

# Shared shape for the local gates, so the image and the PyYAML pin have
# one home.
.pyyaml-gate:
  stage: lint
  image: python:3.13-slim
  tags: []
  needs: []
  variables:
    PYYAML_VERSION: "6.0.2"
  before_script:
    # `--user`: the shared non-root runner cannot write system site-packages.
    - pip install --user --quiet --no-cache-dir "pyyaml==$PYYAML_VERSION"

# The manifest gates share a trigger: any kubernetes/ change, any gate script,
# and the pipeline file itself.
.manifest-gate:
  extends: .pyyaml-gate
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes:
        - "kubernetes/**/*"
        - "scripts/check-*.py"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'

# The library-pin gate: every include above must pin exactly
# variables.WEISSSRV_LIB_REF, as a release tag.
lib-pin-check:
  extends: .pyyaml-gate
  script:
    - python3 scripts/check-lib-pins.py --project {{ lib_project }}
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes:
        - ".gitlab-ci.yml"
        - "scripts/check-lib-pins.py"
    - if: '$CI_COMMIT_BRANCH == "main"'

# The egress fence: networkpolicy.yaml's except-list is the only thing keeping
# this pod off the LAN, the tailnet and the cloud-metadata address, and it is
# the file a tenant edits to add an egress rule.
netpol-check:
  extends: .manifest-gate
  script:
    - python3 scripts/check-netpol-except-parity.py kubernetes/flux

# Holds servicemonitor.yaml's scraped port and the NetworkPolicy that admits
# observability in step; a no-op when the tree has no monitor.
scrape-wiring-check:
  extends: .manifest-gate
  script:
    - >-
      python3 scripts/check-scrape-wiring.py kubernetes/flux
      --namespace {{ app_namespace }}

# CRITICAL: the included `flux-lint` JOB passes on an empty render (kustomize
# and kubeconform both exit 0 on one) and the cluster-side Kustomization prunes,
# so an emptied `resources:` list would delete every object in
# {{ app_namespace }}. A manifest present but unlisted is never built.
kustomization-check:
  extends: .manifest-gate
  script:
    - python3 scripts/check-kustomization.py kubernetes/flux
