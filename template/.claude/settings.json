      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl top:*)",
      "Bash(kubectl api-resources:*)",
      "Bash(kubectl version:*)",
      "Bash(flux get:*)",
      "Bash(flux check:*)",
      "Bash(flux logs:*)",
      "Bash(flux tree:*)",
      "Bash(flux build:*)",
      "Bash(kustomize build:*)",
      "Bash(kubeconform:*)",
      "Bash(yamllint:*)",
      "Bash(shellcheck:*)",
      "Bash(docker build:*)",
      "Bash(task:*)",
      "Bash(yq:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.gitlab.com)",
      "WebFetch(domain:fluxcd.io)",
      "WebFetch(domain:external-secrets.io)",
      "WebFetch(domain:doc.traefik.io)"
