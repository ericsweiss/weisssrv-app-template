---
# WAL archive and nightly base backups, 30 days. Never pruned: the archive is
# the point-in-time recovery source.
apiVersion: barmancloud.cnpg.io/v1
kind: ObjectStore
metadata:
  name: {{ app_slug }}-backups
  annotations:
    kustomize.toolkit.fluxcd.io/prune: disabled
spec:
  retentionPolicy: "30d"
  configuration:
    destinationPath: s3://{{ db_backup_bucket }}/
    endpointURL: {{ db_backup_endpoint }}
    s3Credentials:
      accessKeyId:
        name: {{ app_slug }}-backups
        key: access-key-id
      secretAccessKey:
        name: {{ app_slug }}-backups
        key: secret-access-key
    wal:
      compression: gzip
      maxParallel: 2
    data:
      compression: gzip
  instanceSidecarConfiguration:
    # Several S3-compatible stores reject the checksum headers recent boto3
    # sends by default; computing them only when required keeps archiving working.
    env:
      - name: AWS_REQUEST_CHECKSUM_CALCULATION
        value: when_required
      - name: AWS_RESPONSE_CHECKSUM_VALIDATION
        value: when_required
    resources:
      requests:
        cpu: 10m
        memory: 64Mi
      limits:
        memory: 256Mi
