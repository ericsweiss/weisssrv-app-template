# migrate owns the schema, app runs the service, ro serves reports and the dump.
# CNPG reloads on change; mount as files, never env. urlquery escapes a space
# as '+', which libpq reads as a plus: hence replace.
{%- for role in ['migrate', 'app', 'ro'] %}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ app_slug }}-db-{{ role }}
spec:
  refreshInterval: 24h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-{{ app_slug }}
  target:
    name: {{ app_slug }}-db-{{ role }}
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: kubernetes.io/basic-auth
      metadata:
        labels:
          cnpg.io/reload: "true"
      data:
        username: {{ db_role_prefix }}_{{ role }}
        user: {{ db_role_prefix }}_{{ role }}
        password: "{% raw %}{{ .password }}{% endraw %}"
        host: {{ app_slug }}-db-rw
        port: "5432"
        dbname: {{ db_name | tojson }}
        sslmode: verify-full
        uri: 'postgresql://{{ db_role_prefix }}_{{ role }}:{% raw %}{{ .password | urlquery | replace "+" "%20" }}{% endraw %}@{{ app_slug }}-db-rw:5432/{{ db_name }}?sslmode=verify-full'
  data:
    - secretKey: password
      remoteRef:
        key: {{ (app_slug ~ ": " ~ db_roles_item) | tojson }}
        property: {{ role }}-password
{%- endfor %}
