---
# Owner and migrations role; CNPG re-applies its password whenever this Secret
# changes. Role Secrets follow weisssrv-lib's DATABASE-CONTRACT.md (files, never
# env). urlquery escapes a space as '+', which libpq reads as a plus: hence replace.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ app_slug }}-db-migrate
spec:
  refreshInterval: 24h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-{{ app_slug }}
  target:
    name: {{ app_slug }}-db-migrate
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: kubernetes.io/basic-auth
      metadata:
        labels:
          cnpg.io/reload: "true"
      data:
        username: {{ db_role_prefix }}_migrate
        user: {{ db_role_prefix }}_migrate
        password: "{% raw %}{{ .password }}{% endraw %}"
        host: {{ app_slug }}-db-rw
        port: "5432"
        dbname: {{ db_name }}
        sslmode: verify-full
        uri: 'postgresql://{{ db_role_prefix }}_migrate:{% raw %}{{ .password | urlquery | replace "+" "%20" }}{% endraw %}@{{ app_slug }}-db-rw:5432/{{ db_name }}?sslmode=verify-full'
  data:
    - secretKey: password
      remoteRef:
        key: "{{ app_slug }}: {{ db_roles_item }}"
        property: migrate-password
---
# Runtime role: SELECT and INSERT by default, UPDATE or DELETE only where a
