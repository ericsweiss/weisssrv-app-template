---
# The bucket-scoped object-store key; only the plugin sidecar reads it.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ app_slug }}-backups
spec:
  refreshInterval: 24h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-{{ app_slug }}
  target:
    name: {{ app_slug }}-backups
    creationPolicy: Owner
  data:
    - secretKey: access-key-id
      remoteRef:
        key: "{{ app_slug }}: {{ db_backup_item }}"
        property: access-key-id
    - secretKey: secret-access-key
      remoteRef:
        key: "{{ app_slug }}: {{ db_backup_item }}"
        property: secret-access-key
