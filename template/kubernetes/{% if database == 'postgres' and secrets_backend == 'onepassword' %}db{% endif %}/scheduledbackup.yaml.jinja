---
# Nightly base backup at 11:00 UTC, plus one at creation.
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: {{ app_slug }}-db-nightly
spec:
  schedule: "0 0 11 * * *"
  immediate: true
  backupOwnerReference: self
  cluster:
    name: {{ app_slug }}-db
  method: plugin
  pluginConfiguration:
    name: barman-cloud.cloudnative-pg.io
