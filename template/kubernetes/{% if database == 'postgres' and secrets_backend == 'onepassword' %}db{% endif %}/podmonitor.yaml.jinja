---
# The instance exporter on 9187 (port name metrics); db-allow-ingress admits
# observability on that port.
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: {{ app_slug }}-db
spec:
  selector:
    matchLabels:
      cnpg.io/cluster: {{ app_slug }}-db
      cnpg.io/podRole: instance
  podMetricsEndpoints:
    - port: metrics
