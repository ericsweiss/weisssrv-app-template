---
# Point `port` (the named Service port) and `path` at the app's real metrics
# endpoint: one that 404s scrapes `up == 0` and trips the platform's TargetDown
# alert. networkpolicy.yaml's scrape allow must name the same port.
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: {{ app_slug }}
  labels:
    app.kubernetes.io/name: {{ app_slug }}
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ app_slug }}
  endpoints:
    # `http` is the port the public IngressRoute backends, so /metrics served
    # there is reachable from the internet. Serve it on a second containerPort
    # instead: docs/ARCHITECTURE.md, Observability.
    - port: http
      path: /metrics
      interval: 30s
