---
# Registry pull credentials for a PRIVATE image registry, keyed on each
# distinct registry hostname (the kubelet matches the literal host in the
# image ref). Operator setup: docs/ONBOARDING.md step O2b.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ app_slug }}-registry
spec:
  refreshInterval: 24h
  secretStoreRef:
    kind: ClusterSecretStore
    name: {{ secrets_backend }}-{{ app_slug }}
  target:
    name: {{ app_slug }}-registry
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: kubernetes.io/dockerconfigjson
      data:
{#- toJson emits its own quotes: a fetched value containing " or a newline
would otherwise render a .dockerconfigjson that is not valid JSON, which the
kubelet reports only as ImagePullBackOff. #}
{%- set cred = '{"username":{{ .username | toJson }},"password":{{ .token | toJson }},"auth":"{{ printf "%s:%s" .username .token | b64enc }}"}' %}
{%- set hosts = [registry_host, registry_pull_host] | unique | list %}
        .dockerconfigjson: |
          {"auths":{
{%- for host in hosts %}
            "{{ host }}":{{ cred }}{{ "," if not loop.last else "}}" }}
{%- endfor %}
  data:
    - secretKey: token
      remoteRef:
{%- if secrets_backend == 'onepassword' %}
        key: "{{ app_slug }}: Registry Pull"
        property: token
{%- else %}
        key: REGISTRY_PULL_TOKEN
{%- endif %}
    - secretKey: username
      remoteRef:
{%- if secrets_backend == 'onepassword' %}
        key: "{{ app_slug }}: Registry Pull"
        property: username
{%- else %}
        key: REGISTRY_PULL_USERNAME
{%- endif %}
