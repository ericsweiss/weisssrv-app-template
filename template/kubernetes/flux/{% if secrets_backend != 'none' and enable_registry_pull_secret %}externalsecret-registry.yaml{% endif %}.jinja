---
# Registry pull credentials for a PRIVATE image registry. deployment.yaml
# already carries the matching `imagePullSecrets:` entry.
#
# Operator side (docs/ONBOARDING.md step O2b): create a deploy token with the
# `read_registry` scope on this project and store its value in the tenant's
# secret backend under the fields read below. The deploy-token USERNAME is
# generated by the forge, so it is read from the store alongside the token
# rather than assumed.
#
# Credentials are keyed on BOTH registry hostnames: the kubelet matches pull
# secrets against the literal host in the image reference, and nodes may pull
# via a different name than the one the image is pushed to.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ app_slug }}-registry
spec:
  refreshInterval: 24h
  secretStoreRef:
    kind: ClusterSecretStore
    name: {{ secrets_backend }}-{{ app_slug }}
  target:
    name: {{ app_slug }}-registry
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: kubernetes.io/dockerconfigjson
      data:
{%- set cred = '{"username":"{{ .username }}","password":"{{ .token }}","auth":"{{ printf "%s:%s" .username .token | b64enc }}"}' %}
{%- set hosts = [registry_host, registry_pull_host] | unique | list %}
        .dockerconfigjson: |
          {"auths":{
{%- for host in hosts %}
            "{{ host }}":{{ cred }}{{ "," if not loop.last else "}}" }}
{%- endfor %}
  data:
    - secretKey: token
      remoteRef:
{%- if secrets_backend == 'onepassword' %}
        key: "{{ app_slug }}: Registry Pull"
        property: token
{%- else %}
        key: REGISTRY_PULL_TOKEN
{%- endif %}
    - secretKey: username
      remoteRef:
{%- if secrets_backend == 'onepassword' %}
        key: "{{ app_slug }}: Registry Pull"
        property: username
{%- else %}
        key: REGISTRY_PULL_USERNAME
{%- endif %}
