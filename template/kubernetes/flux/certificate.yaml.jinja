---
# Per-host TLS from the platform ClusterIssuer (DNS-01). Must share the
# IngressRoute's namespace: Traefik reads the secret only from the route's own
# namespace. Why per-host and not wildcard: docs/ARCHITECTURE.md.
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ app_slug }}-tls
spec:
  secretName: {{ app_slug }}-{{ external_domain.split('.')[0] }}-tls
  issuerRef:
    name: letsencrypt-prod
    kind: ClusterIssuer
  # `dnsNames` alone: Let's Encrypt issues no Common Name.
  dnsNames:
    - {{ app_slug }}.{{ external_domain }}
  renewBefore: 720h
