---
# Internal route: {{ app_slug }}.{{ internal_domain }}. `lan-tailscale-only`
# restricts the source to the LAN, the tailnet and the pod CIDR. The operator
# adds the DNS record, docs/ONBOARDING.md step O5.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ app_slug }}-internal
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`{{ app_slug }}.{{ internal_domain }}`)
      kind: Rule
      middlewares:
        - name: lan-tailscale-only
          namespace: traefik
        - name: hsts-header
          namespace: traefik
{%- if enable_sso %}
        # No forward-auth: this hostname is source-filtered, not authenticated.
        # Gating it needs a second Authentik provider (docs/ONBOARDING.md O8).
{%- endif %}
      services:
        - name: {{ app_slug }}
          port: {{ app_port }}
  tls:
    secretName: {{ app_slug }}-{{ internal_domain.split('.')[0] }}-tls
