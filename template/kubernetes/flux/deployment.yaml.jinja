---
# Application workload. Hardened, non-root so it satisfies the tenant
# namespace's Pod Security Admission (enforce: baseline / warn+audit:
# restricted). Swap the image, probe paths and resources for your app.
#
# The image tag is a PLACEHOLDER no registry has, so the first reconcile
# ImagePullBackOffs until you replace it{% if enable_image_build %} — with a tag this repo's own image
# build publishes. Which tag that is follows from the CI shape, so it is named
# in README.md's first step rather than here, where the shape is not known{% endif %}.
# Tags are LITERAL pins: Flux postBuild `${var}` substitution is
# cluster-internal and not available to tenants.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app_slug }}
  labels:
    app.kubernetes.io/name: {{ app_slug }}
spec:
{%- if enable_hpa %}
  # No `replicas:` — hpa.yaml owns the replica count, and Flux server-side apply
  # would otherwise fight the HPA over the field on every reconcile.
{%- else %}
  # {{ replica_count }} replica{{ 's' if replica_count > 1 else '' }}{% if replica_count > 1 %}, so a rolling update never drops to zero{% endif %}.
  replicas: {{ replica_count }}
{%- endif %}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ app_slug }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ app_slug }}
    spec:
      automountServiceAccountToken: false
{%- if secrets_backend != 'none' and enable_registry_pull_secret %}
      # The registry is private; the credential comes from
      # externalsecret-registry.yaml.
      imagePullSecrets:
        - name: {{ app_slug }}-registry
{%- endif %}
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      # Soft NAS-avoidance. To PIN to the storage node instead (zvol-backed
      # data), see docs/ARCHITECTURE.md § Storage & scheduling.
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              preference:
                matchExpressions:
                  - key: {{ node_label_domain }}/nas
                    operator: DoesNotExist
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchLabels:
                    app.kubernetes.io/name: {{ app_slug }}
      containers:
        - name: app
          image: {{ registry_host }}/{{ git_namespace }}/{{ app_slug }}:REPLACE-ME
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: {{ app_port }}
              protocol: TCP
{%- if secrets_backend != 'none' %}
          # Bind each secret key as its own env var: the ExternalSecret's keys
          # are hyphenated per the homelab convention and hyphens are not valid
          # env-var names, so `envFrom: secretRef` would silently SKIP them.
          # `optional: true` lets the pod start before ESO wires the store.
          env:
            - name: API_KEY
              valueFrom:
                secretKeyRef:
                  name: {{ app_slug }}-secrets
                  key: api-key
                  optional: true
{%- endif %}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          # Adjust to your app's health endpoints. The liveness grace on a slow
          # boot is ~75s — anything slower needs a startupProbe.
          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
          resources:
            requests:
              cpu: 25m
              memory: 64Mi
            limits:
              memory: 256Mi
          # readOnlyRootFilesystem is on; add emptyDir mounts as the app needs.
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
