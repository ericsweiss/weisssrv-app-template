---
# Application workload, hardened for the namespace's Pod Security Admission.
# Swap the image, probe paths and resources for your app. The image tag is a
# PLACEHOLDER no registry has, so the first reconcile ImagePullBackOffs.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app_slug }}
  labels:
    app.kubernetes.io/name: {{ app_slug }}
spec:
{%- if enable_hpa %}
  # No `replicas:` — hpa.yaml owns the replica count, and Flux server-side apply
  # would otherwise fight the HPA over the field on every reconcile.
{%- else %}
{%- if replica_count > 1 %}
  # {{ replica_count }} replicas, so a rolling update never drops to zero.
{%- endif %}
  replicas: {{ replica_count }}
{%- endif %}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ app_slug }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ app_slug }}
    spec:
      automountServiceAccountToken: false
{%- if secrets_backend != 'none' and enable_registry_pull_secret %}
      # The registry is private; the credential comes from
      # externalsecret-registry.yaml.
      imagePullSecrets:
        - name: {{ app_slug }}-registry
{%- endif %}
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      # Soft NAS-avoidance. To PIN to the storage node instead, see
      # docs/ARCHITECTURE.md § Storage & scheduling.
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              preference:
                matchExpressions:
                  - key: {{ node_label_domain }}/nas
                    operator: DoesNotExist
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchLabels:
                    app.kubernetes.io/name: {{ app_slug }}
      containers:
        - name: app
          image: {{ registry_host }}/{{ git_namespace | lower }}/{{ app_slug }}:REPLACE-ME
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: {{ app_port }}
              protocol: TCP
{%- if secrets_backend != 'none' %}
          # CRITICAL: a key the backing secret lacks holds the pod in
          # CreateContainerConfigError. One key at a time because the keys are
          # hyphenated and `envFrom: secretRef` silently SKIPS a hyphenated name.
          env:
            - name: API_KEY
              valueFrom:
                secretKeyRef:
                  name: {{ app_slug }}-secrets
                  key: api-key
{%- endif %}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          # Adjust to your app's health endpoints. The liveness grace on a slow
          # boot is ~55s; anything slower needs a startupProbe.
          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
          resources:
            requests:
              cpu: 25m
              memory: 64Mi
              ephemeral-storage: 64Mi
            limits:
{%- if enable_vpa %}
              # vpa.yaml caps maxAllowed.memory at this value; move both together.
{%- endif %}
              memory: 256Mi
              # Sized above the /tmp emptyDir below plus the node's rotated
              # container logs, which share this budget; at the emptyDir's own
              # size the kubelet evicts the pod before the volume ever fills.
              ephemeral-storage: 512Mi
          # readOnlyRootFilesystem is on; add emptyDir mounts, each with a
          # sizeLimit, as the app needs.
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir:
            # Node ephemeral storage. Raise the container's ephemeral-storage
            # limit with it, and keep that limit above this value.
            sizeLimit: 64Mi
