---
# Public route: {{ app_slug }}.{{ external_domain }}. external-dns reads the
# target annotation below and creates the public DNS record, no operator action.
# Middlewares are referenced from their owning namespace (docs/ARCHITECTURE.md).
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ app_slug }}
  annotations:
    external-dns.alpha.kubernetes.io/target: {{ external_domain }}
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`{{ app_slug }}.{{ external_domain }}`)
      kind: Rule
      middlewares:
        - name: hsts-header
          namespace: traefik
{%- if enable_sso %}
        # Forward-auth authenticates nothing on its own: the operator creates
        # the provider, application, group, binding and outpost entry
        # (docs/ONBOARDING.md step O8).
        - name: authentik-auth
          namespace: authentik
{%- endif %}
      services:
        - name: {{ app_slug }}
          port: {{ app_port }}
  tls:
    secretName: {{ app_slug }}-{{ external_domain.split('.')[0] }}-tls
