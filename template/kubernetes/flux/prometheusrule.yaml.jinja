---
# Every expression pins `namespace`: tenant rules evaluate cluster-wide, so
# without it AppDown fires on another namespace's like-named Deployment and
# absent() silently disarms AppAbsent. See docs/ARCHITECTURE.md.
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: {{ app_slug }}
  labels:
    app.kubernetes.io/name: {{ app_slug }}
spec:
  groups:
    - name: {{ app_slug }}
      rules:
        - alert: AppDown
          expr: kube_deployment_status_replicas_available{namespace="{{ app_namespace }}", deployment="{{ app_slug }}"} < 1
          for: 10m
          labels:
            severity: critical
          annotations:
            runbook_url: '{{ runbooks_page ~ "#appdown" if runbooks_page else runbook_url }}'
            summary: '{{ app_slug }} has no available replicas'
            description: >-
              Deployment {{ app_slug }} has had zero available replicas for 10m
              in namespace {% raw %}{{ $labels.namespace }}{% endraw %}.
        - alert: AppAbsent
          expr: absent(kube_deployment_status_replicas_available{namespace="{{ app_namespace }}", deployment="{{ app_slug }}"})
          for: 15m
          labels:
            severity: warning
            # Keeps the alert routed to this namespace when an edited expr
            # drops the label that absent() copies from its selector.
            namespace: {{ app_namespace }}
          annotations:
            runbook_url: '{{ runbooks_page ~ "#appabsent" if runbooks_page else runbook_url }}'
            summary: '{{ app_slug }} deployment metric is absent'
            description: >-
              No kube-state metric for Deployment {{ app_slug }} for 15m — it
              may have been pruned or never reconciled.
