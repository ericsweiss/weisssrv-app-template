---
# Horizontal Pod Autoscaler on CPU. It owns the replica count, so the
# Deployment ships no `replicas:`.{% if enable_vpa %} vpa.yaml is memory-only.{% endif %}
# Utilisation is relative to `requests.cpu`, so raise it with the image.
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ app_slug }}
  labels:
    app.kubernetes.io/name: {{ app_slug }}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{ app_slug }}
  minReplicas: 2
  maxReplicas: 5
{%- if database == 'postgres' and secrets_backend == 'onepassword' %}
  # The Deployment's name selector also matches the database and dump pods, so
  # their CPU is averaged in here and a busy database can scale the app up.
{%- endif %}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 80
  behavior:
    scaleDown:
      stabilizationWindowSeconds: 300
