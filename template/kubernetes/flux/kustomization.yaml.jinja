---
# Tenant workload aggregate; the cluster-side Kustomization points at this
# directory. No `namespace:` here: it supplies `targetNamespace`, and the
# operator owns the Namespace and its PSA labels (docs/ONBOARDING.md).
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - deployment.yaml
  - service.yaml
{%- if secrets_backend != 'none' %}
  - externalsecret.yaml
{%- endif %}
{%- if secrets_backend != 'none' and enable_registry_pull_secret %}
  - externalsecret-registry.yaml
{%- endif %}
  - certificate.yaml
  - ingressroute.yaml
{%- if enable_internal_ingress %}
  - certificate-internal.yaml
  - ingressroute-internal.yaml
{%- endif %}
  - networkpolicy.yaml
{%- if enable_servicemonitor %}
  - servicemonitor.yaml
{%- endif %}
  - prometheusrule.yaml
{%- if enable_vpa %}
  - vpa.yaml
{%- endif %}
{%- if enable_hpa %}
  - hpa.yaml
{%- endif %}
{%- if replica_count > 1 or enable_hpa %}
  - pdb.yaml
{%- endif %}
