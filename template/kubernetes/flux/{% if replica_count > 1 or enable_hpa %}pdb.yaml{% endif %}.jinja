---
# Keeps one replica up across voluntary disruptions. Rendered only where there
# is room for it (more than one replica, or the HPA whose minReplicas is 2): at
# one replica `minAvailable: 1` blocks every eviction and a node never drains.
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: {{ app_slug }}
  labels:
    app.kubernetes.io/name: {{ app_slug }}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ app_slug }}
{%- if database == 'postgres' and secrets_backend == 'onepassword' %}
    # The database and dump pods share the name label; counted here, they would
    # stand in for app replicas and block the instance's own drain.
    matchExpressions:
      - key: app.kubernetes.io/component
        operator: NotIn
        values: [db]
{%- endif %}
