---
{%- if secrets_backend == 'onepassword' %}
# Secrets pulled into the namespace by the External Secrets Operator from the
# 1Password backend. The ClusterSecretStore is created OPERATOR-SIDE
# (docs/ONBOARDING.md step O3); this manifest only references it.
#
# Items are PREFIXED with the slug in the shared vault to isolate this tenant's
# from another's: `remoteRef.key` is the full item title "{{ app_slug }}: <Item>"
# and `remoteRef.property` is the field name. No op:// URIs, no item IDs.
{%- else %}
# Secrets pulled into the namespace by the External Secrets Operator from the
# GitLab CI/CD-variable backend — the backend for a collaborator with no vault
# access. The ClusterSecretStore is created OPERATOR-SIDE
# (docs/ONBOARDING.md step O3); this manifest only references it. Each masked
# CI/CD variable on this project maps straight across as a `remoteRef.key`.
{%- endif %}
#
# deployment.yaml binds each `secretKey` explicitly with `secretKeyRef`, because
# the hyphenated keys an `envFrom` would silently drop are the convention here.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ app_slug }}-secrets
spec:
  refreshInterval: 24h
  secretStoreRef:
    kind: ClusterSecretStore
    name: {{ secrets_backend }}-{{ app_slug }}
  target:
    name: {{ app_slug }}-secrets
    creationPolicy: Owner
  data:
    - secretKey: api-key
      remoteRef:
{%- if secrets_backend == 'onepassword' %}
        key: "{{ app_slug }}: {{ secret_item }}"
        property: api-key
{%- else %}
        key: APP_API_KEY
{%- endif %}
