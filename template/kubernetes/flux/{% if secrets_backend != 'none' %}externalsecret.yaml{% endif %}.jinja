---
{%- if secrets_backend == 'onepassword' %}
# Secrets pulled in by the External Secrets Operator from the 1Password backend.
# `remoteRef.key` is the full item title, `remoteRef.property` the field.
# The ClusterSecretStore is operator-side: docs/ONBOARDING.md step O3.
{%- else %}
# Secrets pulled in by the External Secrets Operator from the GitLab
# CI/CD-variable backend: each masked variable is one `remoteRef.key`.
# The ClusterSecretStore is operator-side: docs/ONBOARDING.md step O3.
{%- endif %}
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ app_slug }}-secrets
spec:
  refreshInterval: 24h
  secretStoreRef:
    kind: ClusterSecretStore
    name: {{ secrets_backend }}-{{ app_slug }}
  target:
    name: {{ app_slug }}-secrets
    creationPolicy: Owner
  data:
    - secretKey: api-key
      remoteRef:
{%- if secrets_backend == 'onepassword' %}
        key: "{{ app_slug }}: {{ secret_item }}"
        property: api-key
{%- else %}
        key: APP_API_KEY
{%- endif %}
