---
version: "3"

# Task runner for local development. `task --list` shows everything.
# Cluster-touching tasks need a kubeconfig on KUBECONFIG; all are read-only
# except `flux:reconcile`, which only pokes the reconciler.

vars:
  APP: {{ app_slug }}
  NAMESPACE: {{ app_namespace }}
  KUSTOMIZATION: {{ app_slug }}
  # The cluster's Kubernetes minor, for kubeconform.
  K8S_VERSION: "{{ k8s_version }}"
  # The datreeio CRD-catalog revision kubeconform reads CR schemas from.
  # Pinned to a sha: a catalog rewrite must not change what this gate accepts.
{%- if ci_shape == 'gitlab_selfhosted' %}
  # .gitlab-ci.yml's flux-lint include passes the same commit; bump both.
{%- endif %}
  CRD_CATALOG_REF: "ad3b08c5045129d7bb1eeffd8e61719b2c8dd1e2"
  # Resources kubeconform may validate against no schema. Raise it for a CR
  # the public catalog does not carry; see docs/ARCHITECTURE.md.
  ALLOWED_SKIPS: "0"

# Precondition anchors aliased by the gates below.
x-preconditions:
  needs_pyyaml: &needs_pyyaml
    sh: python3 -c "import yaml" 2>/dev/null
    msg: "PyYAML not installed (pip install pyyaml)"
  needs_python3: &needs_python3
    sh: command -v python3
    msg: "python3 not installed"

tasks:
  default:
    cmds:
      - task --list
    silent: true

  lint:
    desc: Run every local gate.
    cmds:
      - task: yaml-lint
      - task: flux-lint
      - task: python-lint
      - task: doc-links
      - task: comment-length
      - task: netpol
      - task: scrape-wiring
      - task: kustomization
{%- if ci_shape == 'gitlab_selfhosted' %}
      - task: lib-pins
      - task: ci-job-names
{%- endif %}

  yaml-lint:
    desc: Lint YAML with the shared lint/yamllint-relaxed.yml profile.
    cmds:
      - yamllint -c lint/yamllint-relaxed.yml .

  flux-lint:
    desc: kustomize build + kubeconform over the manifests Flux reconciles.
    # CRITICAL: kubeconform exits 0 on empty input and on a resource it skipped
    # for want of a schema, so the render's size and the skip count are the
    # gate. scripts/flux-lint.sh is where both floors live.
{%- if ci_shape == 'gitlab_selfhosted' %}
    # The pipeline's flux-lint job runs this same file, so local lint and CI
    # share one implementation rather than two copies of it.
{%- elif ci_shape == 'github' %}
    # The vendored ci.yml's flux-lint job runs the same checks inline, against
    # the same catalog commit and the same skip budget.
{%- else %}
    # No pipeline here, so this task is the whole manifest gate.
{%- endif %}
    cmds:
      - >-
        bash scripts/flux-lint.sh --mode simple
        --kustomize-path kubernetes/flux
        --allowed-skips {% raw %}"{{.ALLOWED_SKIPS}}"{% endraw %}
        --k8s-version {% raw %}"{{.K8S_VERSION}}"{% endraw %}
        --crd-catalog-ref {% raw %}"{{.CRD_CATALOG_REF}}"{% endraw %}

  python-lint:
    desc: Lint the helper scripts in scripts/ with ruff, using ./ruff.toml.
    # ruff resolves ./ruff.toml itself, so no --config. Add your own source
    # directories here once the app carries Python{% if ci_shape == 'gitlab_selfhosted' %}, and in the CI job's
    # `targets:` and `changes:`{% endif %}.
    cmds:
      - |
        # ruff exits 0 on a target holding no Python, so the floor is the gate.
        if [ -z "$(find scripts -name '*.py' -type f -print -quit)" ]; then
          echo 'ruff matched no Python file under scripts/' >&2
          exit 1
        fi
      - ruff check --no-cache --output-format concise scripts

  doc-links:
    desc: Resolve every relative Markdown cross-link (vendored, stdlib-only).
    # CHECK_DOC_LINKS_PATHS turns on the backticked-path pass, so a doc naming
    # a file that does not exist fails too. IGNORE is the escape hatch.
    env:
      CHECK_DOC_LINKS_PATHS: "1"
      CHECK_DOC_LINKS_IGNORE: ""
    preconditions:
      - *needs_python3
    cmds:
      - python3 scripts/check-doc-links.py

  comment-length:
    desc: Comment blocks stay inside the convention's line budget.
    preconditions:
      - *needs_python3
    cmds:
      - python3 scripts/check-comment-length.py .

  netpol:
    desc: "No fenced pod has unrestricted egress (needs pyyaml)."
    # networkpolicy.yaml's except-list is the only thing keeping this pod off
    # the LAN, the tailnet and the cloud-metadata address.
    preconditions:
      - *needs_pyyaml
    cmds:
      - python3 scripts/check-netpol-except-parity.py kubernetes/flux

  scrape-wiring:
    desc: "The scrape allow admits observability on the monitor's port (needs pyyaml)."
    preconditions:
      - *needs_pyyaml
    cmds:
      - >-
        python3 scripts/check-scrape-wiring.py kubernetes/flux
        --namespace {{ app_namespace }}
        --prometheus-pod-label app.kubernetes.io/name=prometheus

  kustomization:
    desc: "kustomization.yaml lists every manifest, and lists at least one (needs pyyaml)."
    # CRITICAL: kustomize renders only what is listed, so an unlisted manifest
    # is inert and an emptied list renders nothing the cluster then prunes.
    preconditions:
      - *needs_pyyaml
    cmds:
      - python3 scripts/check-kustomization.py kubernetes/flux
{%- if ci_shape == 'gitlab_selfhosted' %}

  lib-pins:
    desc: "Every library pin reads the pipeline's declared lib_ref (needs pyyaml)."
    preconditions:
      - *needs_pyyaml
    cmds:
      - python3 scripts/check-lib-pins.py --project {{ lib_project }}

  ci-job-names:
    desc: "Every optional `needs:` resolves to a job an include creates (needs pyyaml + a library checkout)."
    # GitLab ignores an optional need naming no job, so a renamed library job
    # stops the review waiting for lint and nothing says so. The declared blind
    # spot is GitLab's own Secret-Detection template, which neither checkout holds.
    preconditions:
      - *needs_pyyaml
      - sh: test -d "$WEISSSRV_LIB_PATH"
        msg: "set WEISSSRV_LIB_PATH to a {{ lib_project }} checkout at {{ lib_ref }}"
    cmds:
      - >-
        python3 scripts/check-ci-include-job-names.py --require-optional-needs
        --allow-unreadable-include 'Jobs/Secret-Detection.gitlab-ci.yml=GitLab
        ships this template with the instance, so it is in neither checkout'
{%- endif %}

  render:
    desc: Print the rendered manifests kustomize will hand to Flux.
    cmds:
      - kustomize build kubernetes/flux
{%- if enable_image_build %}

  build:
    desc: Build the container image locally.
    cmds:
      - docker build -t {% raw %}{{.APP}}{% endraw %}:dev .
{%- endif %}

  flux:status:
    desc: Show the Kustomization's reconcile state (read-only; needs KUBECONFIG).
    cmds:
      - flux get kustomization {% raw %}{{.KUSTOMIZATION}}{% endraw %}

  flux:reconcile:
    desc: Force an immediate reconcile of the Kustomization (needs KUBECONFIG).
    cmds:
      - flux reconcile kustomization {% raw %}{{.KUSTOMIZATION}}{% endraw %} --with-source
{%- if secrets_backend != 'none' %}

  secrets:check:
    desc: Check ExternalSecret sync status in the namespace (needs KUBECONFIG).
    cmds:
      - kubectl get externalsecret -n {% raw %}{{.NAMESPACE}}{% endraw %}
{%- endif %}
