# Secrets / local env — never commit these.
.env
.env.*
*.env
.tmp/

# CI scratch — render-validate installs kustomize/kubeconform here.
.bin/

# Rendered template instances (`tests/render_app.py --out`, local copier runs).
# Anchored so nothing under template/ can match by accident.
/.render/
/render/

# Kubeconfigs (bring your own; never commit)
kubeconfig
*.kubeconfig
.kube/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
# coverage.py: local `coverage run` / pytest --cov output.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Agent tooling — keep the shared config, drop the per-machine overrides.
.claude/settings.local.json

# Editor / OS cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
